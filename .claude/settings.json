{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf *)", "Bash(rm -fr *)", "Bash(rm -Rf *)", "Bash(rm -fR *)",
      "Bash(rm -r -f *)", "Bash(rm -f -r *)", "Bash(rm --recursive*)", "Bash(rm -r *)", "Bash(rm -R *)",
      "Bash(git push*)", "Bash(git *push *)",
      "Bash(git reset --hard*)", "Bash(git *reset *--hard*)",
      "Bash(git clean*)", "Bash(git *clean *)",
      "Bash(git checkout -- .*)", "Bash(git restore .*)", "Bash(git restore -- .*)",
      "Bash(git branch -D*)", "Bash(git branch -d*)", "Bash(git rebase*)",
      "Bash(git checkout master*)", "Bash(git checkout main*)", "Bash(git switch master*)", "Bash(git switch main*)",
      "Bash(git filter-branch*)", "Bash(git stash drop*)", "Bash(git stash clear*)",
      "Bash(sudo *)", "Bash(format *)",
      "PowerShell(Remove-Item *-Recurse*)", "PowerShell(Remove-Item * -r*)", "PowerShell(Remove-Item -r*)",
      "PowerShell(rm *-Recurse*)", "PowerShell(rm * -r*)", "PowerShell(rmdir *)", "PowerShell(del *-Recurse*)",
      "PowerShell(git push*)", "PowerShell(git *push *)",
      "PowerShell(git reset --hard*)", "PowerShell(git *reset *--hard*)",
      "PowerShell(git clean*)", "PowerShell(git *clean *)",
      "PowerShell(git checkout -- .*)", "PowerShell(git restore .*)",
      "PowerShell(git branch -D*)", "PowerShell(git branch -d*)", "PowerShell(git rebase*)",
      "PowerShell(git checkout master*)", "PowerShell(git checkout main*)",
      "PowerShell(Format-Volume*)", "PowerShell(Clear-Disk*)",
      "Read(**/.env*)", "Edit(**/.env*)"
    ]
  }
}
