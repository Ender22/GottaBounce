+## WK-189 (a): a synthetic fair point near the fighters' midpoint (Tuning showdown_drop_fair_*). Candidate columns every
+## fair_step px within +- fair_search_r of the midpoint; in each column every bounce deck (a LAYER_SURFACES top with a bounce
+## tier, not a bumper) whose top lies within the search box below the column's start. The point hovers clamp(mid.y, top -
+## hover_max, top - hover_min) above that deck, so it is never over a pit / void column. It must be: inside `view` (the view
+## inset; empty = no view test), with no solid inside fair_clear_r (>= the golden collider), no hazard / moving hazard inside
+## fair_hazard_r, open air straight down to the deck, and the deck also under x +- fair_deck_half. Score = max(d_a, d_b), ties ->
+## nearest the midpoint. Radial-gravity spots (a gravity_source well) return INF (the caller falls back to the spawner rule).
+## Vector2.INF = no valid point.
+func wk189_synth_point(pa: Vector2, pb: Vector2, view: Rect2) -> Vector2:   # WK-189
+	var mid: Vector2 = (pa + pb) * 0.5   # WK-189
+	var gdir: Vector2 = GravityField.get_gravity_at(mid)   # WK-189
+	if gdir.length_squared() > 0.01 and gdir.normalized().y < 0.95:   # WK-189: "above a deck" is only defined for screen-down gravity
+		return Vector2.INF   # WK-189
+	var space := get_world_2d().direct_space_state   # WK-189
+	var surf_mask: int = 1 << 2   # WK-189: LevelLoader.LAYER_SURFACES
+	var haz_mask: int = (1 << 3) | (1 << 4)   # WK-189: LAYER_HAZARDS (spikes, crushers, hammers, debris, bombs, well cores) | LAYER_MOVING_HAZARD
+	var r_clear: float = maxf(Tuning.showdown_drop_fair_clear_r, 36.0 * Tuning.showdown_drop_scale)   # WK-189: >= the golden collider
+	var R: float = Tuning.showdown_drop_fair_search_r   # WK-189
+	var step: float = maxf(Tuning.showdown_drop_fair_step, 8.0)   # WK-189
+	var hmin: float = Tuning.showdown_drop_fair_hover_min   # WK-189
+	var hmax: float = maxf(Tuning.showdown_drop_fair_hover_max, hmin)   # WK-189
+	var circ := CircleShape2D.new()   # WK-189
+	var q := PhysicsShapeQueryParameters2D.new()   # WK-189
+	q.shape = circ   # WK-189
+	q.collide_with_areas = true   # WK-189
+	q.collide_with_bodies = true   # WK-189
+	var best := Vector2.INF   # WK-189
+	var best_m := INF   # WK-189
+	var best_c := INF   # WK-189
+	var n: int = int(floor(R / step))   # WK-189
+	for ix in range(-n, n + 1):   # WK-189
+		var x: float = mid.x + float(ix) * step   # WK-189
+		var y_from: float = mid.y - R   # WK-189: decks whose hover band can reach the box: top in (mid.y - R, mid.y + R + hmin]
+		var y_to: float = mid.y + R + hmin   # WK-189
+		for _deck in range(4):   # WK-189: up to 4 stacked decks per column
+			if y_from >= y_to:   # WK-189
+				break   # WK-189
+			var rq := PhysicsRayQueryParameters2D.create(Vector2(x, y_from), Vector2(x, y_to), surf_mask)   # WK-189
+			rq.hit_from_inside = false   # WK-189: a ray starting inside a deck skips it (finds the next one below)
+			var hit: Dictionary = space.intersect_ray(rq)   # WK-189
+			if hit.is_empty():   # WK-189: nothing below in the box = a pit / void column
+				break   # WK-189
+			var top: float = (hit["position"] as Vector2).y   # WK-189
+			y_from = top + 2.0   # WK-189: next deck search starts inside this one
+			var col = hit.get("collider")   # WK-189
+			if col == null or not (col as Object).has_meta("bounce_tier_height") or (hit["normal"] as Vector2).y > -0.7:   # WK-189: a bounce TOP, never a bumper
+				continue   # WK-189
+			var cand := Vector2(x, clampf(mid.y, top - hmax, top - hmin))   # WK-189
+			if absf(cand.y - mid.y) > R:   # WK-189
+				continue   # WK-189
+			if view.size.x > 0.0 and not view.has_point(cand):   # WK-189: inside the camera's framing (view inset)
+				continue   # WK-189
+			var m: float = maxf(cand.distance_to(pa), cand.distance_to(pb))   # WK-189
+			var c: float = cand.distance_to(mid)   # WK-189
+			if m > best_m + 0.5 or (absf(m - best_m) <= 0.5 and c >= best_c):   # WK-189: cheap score test before the physics checks
+				continue   # WK-189
+			if not _wk189_open(space, q, circ, cand, top, x, r_clear, surf_mask, haz_mask):   # WK-189
+				continue   # WK-189
+			best_m = m   # WK-189
+			best_c = c   # WK-189
+			best = cand   # WK-189
+	return best   # WK-189
+
+## WK-189: is `cand` open air above its deck? No solid inside r_clear, no hazard inside fair_hazard_r, a clear drop to the deck
+## top, and deck under x +- fair_deck_half at the same top (+-24 px).
+func _wk189_open(space: PhysicsDirectSpaceState2D, q: PhysicsShapeQueryParameters2D, circ: CircleShape2D, cand: Vector2, top: float,
+		x: float, r_clear: float, surf_mask: int, haz_mask: int) -> bool:   # WK-189
+	q.transform = Transform2D(0.0, cand)   # WK-189
+	circ.radius = r_clear   # WK-189
+	q.collision_mask = surf_mask   # WK-189
