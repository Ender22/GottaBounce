+		return false   # WK-189
+	circ.radius = Tuning.showdown_drop_fair_hazard_r   # WK-189
+	q.collision_mask = haz_mask   # WK-189
+	if not space.intersect_shape(q, 1).is_empty():   # WK-189: near a hazard / moving hazard
+		return false   # WK-189
+	var down := PhysicsRayQueryParameters2D.create(cand, Vector2(x, top - 1.0), surf_mask)   # WK-189: open air straight down to the deck
+	if not space.intersect_ray(down).is_empty():   # WK-189
+		return false   # WK-189
+	for sx in [-Tuning.showdown_drop_fair_deck_half, Tuning.showdown_drop_fair_deck_half]:   # WK-189: deck under both sides (no lip perch)
+		var sq := PhysicsRayQueryParameters2D.create(Vector2(x + sx, cand.y), Vector2(x + sx, top + 24.0), surf_mask)   # WK-189
+		var sh: Dictionary = space.intersect_ray(sq)   # WK-189
+		if sh.is_empty() or absf((sh["position"] as Vector2).y - top) > 24.0:   # WK-189
+			return false   # WK-189
+	return true   # WK-189
 
