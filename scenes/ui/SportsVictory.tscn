[sub_resource type="Shader" id="rays_tint"]
code = "shader_type canvas_item;
// WK-111: recolour the gold victory rays into the winning team's colour by luminance (a plain modulate turns
// gold x blue into olive). Dark outlines stay dark, the brightest cores lift toward white.
uniform vec4 team : source_color = vec4(1.0, 0.82, 0.25, 1.0);
void fragment() {
	vec4 c = texture(TEXTURE, UV);
	float l = dot(c.rgb, vec3(0.299, 0.587, 0.114));
	vec3 t = clamp(team.rgb * l * 1.45, 0.0, 1.0);
	t = mix(t, vec3(1.0), smoothstep(0.82, 1.0, l));
	// COLOR arrives as texture x modulate: replace the rgb, keep its alpha (texture alpha x the fade-in modulate)
	COLOR.rgb = t;
}
"

[sub_resource type="ShaderMaterial" id="rays_mat"]
shader = SubResource("rays_tint")
shader_parameter/team = Color(1, 0.823529, 0.247059, 1)

